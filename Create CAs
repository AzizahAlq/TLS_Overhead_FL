Step 1: Create CA (Certificate Authority)
mkdir certs && cd certs# Generate CA private keyopenssl genrsa -out ca.key 4096# Generate CA certificateopenssl req -x509 -new -nodes -key ca.key -sha256 -days 3650 \-out ca.crt -subj "/CN=FL-CA"

Step 2: Create Server Certificate (with SAN)
Create a config file (like your server.ext):
cat > server.ext <<EOFsubjectAltName = @alt_namesextendedKeyUsage = serverAuthkeyUsage = digitalSignature, keyEncipherment[alt_names]DNS.1 = localhostIP.1 = 127.0.0.1EOF
Then generate:
# Server keyopenssl genrsa -out server.key 4096# CSRopenssl req -new -key server.key -out server.csr \-subj "/CN=localhost"# Sign with CAopenssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key \-CAcreateserial -out server.crt -days 3650 -sha256 \-extfile server.ext

Step 3: Create Clients (this matches your client_0 … client_9)
Loop:
for i in {0..9}do  # Key  openssl genrsa -out client_${i}.key 4096  # CSR  openssl req -new -key client_${i}.key -out client_${i}.csr \  -subj "/CN=client_${i}"  # Extension file  cat > client_${i}.ext <<EOFextendedKeyUsage = clientAuthkeyUsage = digitalSignature, keyEnciphermentEOF  # Sign  openssl x509 -req -in client_${i}.csr -CA ca.crt -CAkey ca.key \  -CAcreateserial -out client_${i}.crt -days 3650 -sha256 \  -extfile client_${i}.extdone

Result 
You get:
ca.crt, ca.key
server.crt, server.key
client_0.crt ... client_9.crt
.csr and .ext files
